# SQLite (mặc định, chạy ngay không cần cài DB)
DATABASE_URL=sqlite+aiosqlite:///./taskhub.db
# PostgreSQL 16
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/taskhub
# MySQL 8
# DATABASE_URL=mysql+aiomysql://user:pass@localhost:3306/taskhub

# JWT: BẮT BUỘC đổi ở môi trường thật. Sinh khoá bằng:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-dev-only-secret-key-32chars-min
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
