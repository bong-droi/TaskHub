# Copy this file to ".env" and edit. Real environment variables always win over files.
#
# Environments: set APP_ENV as a REAL environment variable (do NOT put APP_ENV in .env), e.g.
#   PowerShell:  $env:APP_ENV = "production"
#   Linux/Mac :  export APP_ENV=production
# Files are loaded in this order (later overrides earlier):  .env  ->  .env.<APP_ENV>
# (for example .env.production). Never commit .env or .env.production.

# --- Database (must use an ASYNC driver) ---
# SQLite (default, no setup needed)
DATABASE_URL=sqlite+aiosqlite:///./taskhub.db
# PostgreSQL 16:  DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/taskhub
# MySQL 8:        DATABASE_URL=mysql+aiomysql://user:pass@localhost:3306/taskhub

# --- Auth ---
# REQUIRED to change in production (the app refuses to start otherwise). Min 32 chars.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-dev-only-secret-key-32chars-min
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# --- Cache (Redis). Leave empty to disable caching ---
#   docker run -d --name taskhub-redis -p 6379:6379 redis:7
REDIS_URL=
CACHE_TTL_SECONDS=60

# --- Email on task assignment ---
# console = only write to the log (default); smtp = send for real
EMAIL_BACKEND=console
EMAIL_FROM=TaskHub <no-reply@taskhub.dev>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true

# --- Logging ---
LOG_LEVEL=INFO
